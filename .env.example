# Pick a default provider for every role: anthropic | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Gemini API (Google AI Studio) via Google's OpenAI-compatible endpoint:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_gemini_api_key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AGENT_MODEL=gemini-3.8-flash
# Set PATIENT_MODEL, JUDGE_MODEL, and IMPROVER_MODEL too for per-role model selection.

# Fully local via Ollama (no keys; `ollama pull llama3.1`):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# AGENT_MODEL=llama3.1:latest
# PATIENT_MODEL=llama3.1:latest
# JUDGE_MODEL=llama3.1:latest
# IMPROVER_MODEL=llama3.1:latest
# Per-role endpoints: <ROLE>_BASE_URL / <ROLE>_API_KEY override OPENAI_BASE_URL / OPENAI_API_KEY for one role.

# Optional per-role overrides (roles: AGENT, PATIENT, JUDGE, IMPROVER)
# A weaker agent model makes failures (and the loop) easier to see; a strong judge/improver matters more.
# AGENT_MODEL=claude-haiku-4-5-20251001
# JUDGE_MODEL=claude-sonnet-5-5
# IMPROVER_MODEL=claude-sonnet-5-5
# Use a different provider for the judge than for the agent to reduce shared blind spots:
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4.1
# Set to "none" for models that reject a temperature parameter:
# AGENT_TEMPERATURE=0
